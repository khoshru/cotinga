msgstr "اندازهٔ وعده (انگلیسی، اختیاری)"

msgid ""
"English is saved as the original. Add a Farsi translation below, or use AI "
"to generate both."
msgstr ""
"متن انگلیسی به‌عنوان نسخهٔ اصلی ذخیره می‌شود. ترجمهٔ فارسی را در زیر اضافه کنید "
"یا از هوش مصنوعی برای ساخت هر دو نسخه کمک بگیرید."

msgid ""
"Use English here. You can add Farsi in the translation field or let AI "
"generate both versions."
msgstr ""
"اینجا به انگلیسی بنویسید. متن فارسی را در بخش ترجمه وارد کنید یا از هوش "
"مصنوعی برای ساخت هر دو نسخه کمک بگیرید."

msgid "Calories minimum (kcal)"
msgstr "حداقل کالری (کیلوکالری)"

msgid "Calories maximum (kcal)"
msgstr "حداکثر کالری (کیلوکالری)"

msgid "Protein minimum (g)"
msgstr "حداقل پروتئین (گرم)"

msgid "Protein maximum (g)"
msgstr "حداکثر پروتئین (گرم)"

msgid "Carbs minimum (g)"
msgstr "حداقل کربوهیدرات (گرم)"

msgid "Carbs maximum (g)"
msgstr "حداکثر کربوهیدرات (گرم)"

msgid "Fat minimum (g)"
msgstr "حداقل چربی (گرم)"

msgid "Fat maximum (g)"
msgstr "حداکثر چربی (گرم)"

msgid "Maximum must be at least the minimum."
msgstr "حداکثر باید برابر یا بیشتر از حداقل باشد."

msgid "What did you eat?"
msgstr "چه چیزی خوردید؟"

msgid ""
"Describe one meal or your whole day, including times and portions you "
"remember."
msgstr ""
"یک وعده یا خوراک تمام روز را، همراه با زمان و مقدارهایی که یادتان مانده، شرح "
"دهید."

msgid "OpenRouter API key"
msgstr "کلید API در OpenRouter"

msgid "Leave this blank to keep your saved key."
msgstr "برای حفظ کلید ذخیره‌شده، این قسمت را خالی بگذارید."

msgid "Remove my saved key"
msgstr "حذف کلید ذخیره‌شده"

msgid "Enter a valid OpenRouter API key."
msgstr "یک کلید API معتبر OpenRouter وارد کنید."

msgid "Choose either a new key or removal of the saved key."
msgstr "یکی را انتخاب کنید: کلید جدید یا حذف کلید ذخیره‌شده."

msgid "Weight (kg)"
msgstr "وزن (کیلوگرم)"

msgid "Note (optional)"
msgstr "یادداشت (اختیاری)"

msgid "Choose today or a past date for a weigh-in."
msgstr "برای ثبت وزن، امروز یا یک تاریخ گذشته را انتخاب کنید."

msgid "Goal weight (kg, optional)"
msgstr "وزن هدف (کیلوگرم، اختیاری)"

msgid "Last 7 days"
msgstr "۷ روز گذشته"

msgid "Last 30 days"
msgstr "۳۰ روز گذشته"

msgid "Last 90 days"
msgstr "۹۰ روز گذشته"

msgid "Last year"
msgstr "سال گذشته"

msgid "Custom dates"
msgstr "تاریخ دلخواه"

msgid "Choose both dates for a custom period."
msgstr "برای بازهٔ دلخواه، هر دو تاریخ را انتخاب کنید."

msgid "Choose an ordered date range of up to one year."
msgstr "بازه‌ای با ترتیب درست و حداکثر یک سال انتخاب کنید."

msgid "Statistics can end today or on a past date."
msgstr "تاریخ پایان آمار باید امروز یا در گذشته باشد."

msgid "Age"
msgstr "سن"

msgid "Height (cm)"
msgstr "قد (سانتی‌متر)"

msgid "Current weight (kg)"
msgstr "وزن فعلی (کیلوگرم)"

msgid "Sex for the energy estimate"
msgstr "جنسیت برای برآورد انرژی"

msgid "Choose an option"
msgstr "یک گزینه انتخاب کنید"

msgid "Female"
msgstr "زن"

msgid "Male"
msgstr "مرد"

msgid "Prefer not to say"
msgstr "ترجیح می‌دهم نگویم"

msgid "Usual activity"
msgstr "فعالیت معمول"

msgid "Mostly sitting"
msgstr "بیشتر نشسته"

msgid "Lightly active"
msgstr "فعالیت کم"

msgid "Moderately active"
msgstr "فعالیت متوسط"

msgid "Very active"
msgstr "فعالیت زیاد"

msgid "Your goal"
msgstr "هدف شما"

msgid "Gradual fat loss"
msgstr "کاهش تدریجی چربی"

msgid "Maintain weight"
msgstr "حفظ وزن"

msgid "Gradual weight gain"
msgstr "افزایش تدریجی وزن"

msgid "Anything else to consider?"
msgstr "نکتهٔ دیگری هست؟"

msgid "Your routine, food preferences, training, or other useful context."
msgstr "برنامهٔ روزانه، ترجیح‌های غذایی، تمرین‌ها یا هر نکتهٔ مرتبط دیگر."

msgid "Breakfast"
msgstr "صبحانه"

msgid "Lunch"
msgstr "ناهار"

msgid "Dinner"
msgstr "شام"

msgid "Snack"
msgstr "میان‌وعده"

msgid "Free"
msgstr "رایگان"

#, python-format
msgid "$%(input)s input / $%(output)s output per 1M tokens"
msgstr "ورودی %(input)s دلار / خروجی %(output)s دلار به‌ازای یک میلیون توکن"

msgid "OpenRouter did not accept your key. Check it in your AI settings."
msgstr ""
"OpenRouter کلید شما را نپذیرفت. آن را در تنظیمات هوش مصنوعی بررسی کنید."

msgid ""
"Your OpenRouter key cannot access this request. Check your provider settings."
msgstr ""
"کلید OpenRouter شما به این درخواست دسترسی ندارد. تنظیمات ارائه‌دهنده را بررسی "
"کنید."

msgid "Your OpenRouter balance is insufficient for this model."
msgstr "موجودی OpenRouter شما برای این مدل کافی نیست."

msgid "OpenRouter is busy or your request limit was reached. Try again later."
msgstr ""
"OpenRouter شلوغ است یا به سقف درخواست‌ها رسیده‌اید. کمی بعد دوباره تلاش کنید."

msgid ""
"This model or provider could not accept structured meal estimates. Choose "
"another model."
msgstr ""
"این مدل یا ارائه‌دهنده، برآورد ساختاریافته را نپذیرفت. مدل دیگری انتخاب کنید."

msgid "OpenRouter is temporarily unavailable. Please try again later."
msgstr "OpenRouter موقتاً در دسترس نیست. کمی بعد دوباره تلاش کنید."

msgid "OpenRouter returned an oversized response."
msgstr "پاسخ OpenRouter بیش از اندازه بزرگ بود."

msgid ""
"OpenRouter could not complete the request. Try another model or try again "
"later."
msgstr ""
"OpenRouter نتوانست درخواست را کامل کند. مدل دیگری انتخاب کنید یا کمی بعد "
"دوباره تلاش کنید."

msgid ""
"Could not reach OpenRouter or read its response. Please try again later."
msgstr ""
"اتصال به OpenRouter یا خواندن پاسخ آن ممکن نشد. کمی بعد دوباره تلاش کنید."

msgid "OpenRouter's model catalog is unavailable."
msgstr "فهرست مدل‌های OpenRouter در دسترس نیست."

msgid "No compatible text models are available. Please try again later."
msgstr "مدل متنی سازگاری در دسترس نیست. کمی بعد دوباره تلاش کنید."

msgid "Choose a currently available text model from the model search."
msgstr "یک مدل متنی موجود را از فهرست مدل‌ها انتخاب کنید."

msgid ""
"The model did not return 1–20 usable meals. Describe the foods and portions "
"more clearly."
msgstr ""
"مدل، ۱ تا ۲۰ وعدهٔ قابل استفاده برنگرداند. خوراک و مقدارها را روشن‌تر شرح دهید."

msgid ""
"The model returned invalid nutrition values. Try again with more detail."
msgstr ""
"مقدارهای مواد مغذی در پاسخ مدل معتبر نیست. با جزئیات بیشتر دوباره تلاش کنید."

msgid "The model returned invalid food descriptions."
msgstr "شرح خوراک در پاسخ مدل معتبر نیست."

msgid "The model returned an invalid meal time."
msgstr "زمان وعده در پاسخ مدل معتبر نیست."

#| msgid "The model returned unusable targets. Please try again."
msgid "The model returned incomplete translations. Please try again."
msgstr "ترجمهٔ مدل کامل نبود. لطفاً دوباره تلاش کنید."

msgid ""
"The model's meal estimates could not be validated. Try another model or "
"describe smaller portions."
msgstr ""
"برآورد وعده‌های مدل قابل تأیید نیست. مدل دیگری انتخاب کنید یا مقدارهای "
"کوچک‌تری شرح دهید."

msgid "The model returned invalid estimation notes."
msgstr "توضیح‌های برآورد مدل معتبر نیست."

msgid ""
"The model could not finish the estimates. Try a shorter description or "
"another model."
msgstr ""
"مدل نتوانست برآورد را کامل کند. توضیح کوتاه‌تر یا مدل دیگری امتحان کنید."

msgid ""
"The model did not return a usable meal estimate. Please try another model."
msgstr "مدل، برآورد قابل استفاده‌ای برنگرداند. مدل دیگری امتحان کنید."

#| msgid "The model returned unusable targets. Please try again."
msgid "The model did not return the English original. Please try again."
msgstr "مدل نسخهٔ اصلی انگلیسی را برنگرداند. لطفاً دوباره تلاش کنید."

msgid "The model returned unusable targets. Please try again."
msgstr "هدف‌های پیشنهادی مدل قابل استفاده نیست. لطفاً دوباره تلاش کنید."

msgid "The model could not finish the target suggestion. Please try again."
msgstr "مدل نتوانست پیشنهاد هدف‌ها را کامل کند. لطفاً دوباره تلاش کنید."

msgid "Choose a valid date range."
msgstr "یک بازهٔ زمانی معتبر انتخاب کنید."

msgid ""
"Your weigh-in has been saved. An existing entry for that day is updated."
msgstr ""
"وزن شما ذخیره شد. اگر این روز قبلاً ثبت شده باشد، اطلاعات آن به‌روز می‌شود."

msgid "Weigh-in removed."
msgstr "ثبت وزن حذف شد."

msgid "Your weight goal has been saved."
msgstr "هدف وزن شما ذخیره شد."

#, python-format
msgid "%(amount)s %(unit)s over range"
msgstr "%(amount)s %(unit)s بالاتر از بازه"

msgid "Within your range"
msgstr "در بازهٔ هدف شما"

#, python-format
msgid "On track, %(amount)s %(unit)s left"
msgstr "در مسیر هدف؛ %(amount)s %(unit)s باقی مانده"

#, python-format
msgid "%(amount)s %(unit)s left"
msgstr "%(amount)s %(unit)s باقی مانده"

msgid "Meal added. Your daily summary is up to date."
msgstr "وعده ثبت شد. خلاصهٔ روز شما به‌روز است."

msgid "A quick note about what you ate. Estimates are welcome."
msgstr "یادداشتی کوتاه از خوراک شما. مقدارهای تقریبی هم خوب‌اند."

msgid "Save meal"
msgstr "ذخیرهٔ وعده"

msgid "Meal removed."
msgstr "وعده حذف شد."

msgid "Meal updated."
msgstr "وعده به‌روز شد."

msgid "Edit meal"
msgstr "ویرایش وعده"

msgid "Adjust the food, portion, time, or nutrition values for this entry."
msgstr "خوراک، مقدار، زمان یا مواد مغذی این وعده را اصلاح کنید."

msgid "Save changes"
msgstr "ذخیرهٔ تغییرها"

msgid "Your daily targets have been saved."
msgstr "هدف‌های روزانهٔ شما ذخیره شد."

msgid "Your daily targets"
msgstr "هدف‌های روزانهٔ شما"

msgid "Set the daily calorie and nutrient ranges that work for you."
msgstr "بازهٔ روزانهٔ کالری و مواد مغذی مناسب خودتان را تعیین کنید."

msgid "Save targets"
msgstr "ذخیرهٔ هدف‌ها"

