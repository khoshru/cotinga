msgid "Hide"
msgstr "დამალვა"

msgid "Show"
msgstr "ჩვენება"

msgid "Model selected. Save your settings to use it."
msgstr "მოდელი არჩეულია. მის გამოსაყენებლად შეინახეთ პარამეტრები."

msgid "No matching models. Try a different search."
msgstr "შესაბამისი მოდელი ვერ მოიძებნა. შეცვალეთ საძიებო ტექსტი."

msgid "%s matching models. Use arrow keys and Enter to select."
msgstr "მოიძებნა %s მოდელი. ასარჩევად გამოიყენეთ ისრები და Enter."

msgid "This can take a little while. Your suggestion will be ready to review when the model finishes."
msgstr "ამას შეიძლება ცოტა დრო დასჭირდეს. მოდელის დასრულების შემდეგ შემოთავაზებას შეამოწმებთ."

msgid "Week"
msgstr "კვირა"
