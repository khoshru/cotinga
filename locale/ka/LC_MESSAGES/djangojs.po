msgid ""
msgstr ""
"Project-Id-Version: Cotinga\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-11-09 13:30+0400\n"
"Language: ka\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n!=1);\n"

msgid "Hide"
msgstr "დამალვა"

msgid "Show"
msgstr "ჩვენება"

msgid "Model selected. Save your settings to use it."
msgstr "მოდელი არჩეულია. მის გამოსაყენებლად შეინახეთ პარამეტრები."

msgid "No matching models. Try a different search."
msgstr "შესაბამისი მოდელი ვერ მოიძებნა. შეცვალეთ საძიებო ტექსტი."

msgid "%s matching models. Use arrow keys and Enter to select."
msgstr "მოიძებნა %s მოდელი. ასარჩევად გამოიყენეთ ისრები და Enter."

msgid "This can take a little while. Your suggestion will be ready to review when the model finishes."
msgstr "ამას შეიძლება ცოტა დრო დასჭირდეს. მოდელის დასრულების შემდეგ შემოთავაზებას შეამოწმებთ."

msgid "Week"
msgstr "კვირა"

msgid ""
"Added to your description. Add another food, or estimate your meals."
msgstr "აღწერაში დაემატა. დაამატეთ სხვა საკვები ან შეაფასეთ კვება."

msgid "Could not save this portion. Please try again."
msgstr "ულუფა ვერ შეინახა. სცადეთ ხელახლა."

msgid "Removed from saved foods. Your diary has not changed."
msgstr "შენახული საკვებიდან წაიშალა. თქვენი დღიური არ შეცვლილა."

msgid "Saved food restored."
msgstr "შენახული საკვები აღდგა."

msgid "Saved just for you. Reuse it next time without typing."
msgstr ""
"ინახება მხოლოდ თქვენთვის. შემდეგ ჯერზე გამოიყენეთ ხელახლა აკრეფის გარეშე."

msgid ""
"Using your usual portion. Changes are just for today unless you remember "
"them."
msgstr ""
"არჩეულია თქვენი ჩვეული ულუფა. ცვლილება მხოლოდ ამ ჩანაწერს ეხება, თუ მის "
"შენახვას არ აირჩევთ."

msgid "Your description is full. Shorten it before adding another portion."
msgstr "აღწერამ დასაშვებ სიგრძეს მიაღწია. ახალი ულუფის დამატებამდე შეამოკლეთ."

msgid "Added"
msgstr "დამატებულია"

msgid "Could not add this exercise. Please try again."
msgstr "სავარჯიშო ვერ დაემატა. სცადეთ ხელახლა."

msgid "Exercise added. Keep choosing, or return to your plan."
msgstr "სავარჯიშო დაემატა. განაგრძეთ არჩევა ან დაბრუნდით პროგრამაზე."

msgid "Searching…"
msgstr "იძებნება…"

msgid "Search is unavailable. Press Search to try again."
msgstr "ძებნა მიუწვდომელია. ხელახლა საცდელად დააჭირეთ ძებნას."

msgid "Saving…"
msgstr "ინახება…"

msgid "Connection interrupted. Your edits are still here. Retry saving."
msgstr "კავშირი გაწყდა. ცვლილებები აქ რჩება. სცადეთ შენახვა ხელახლა."

msgid "Could not save this change. Please try again."
msgstr "ცვლილება ვერ შეინახა. სცადეთ ხელახლა."

msgid "Reload latest workout"
msgstr "ვარჯიშის ბოლო ვერსიის განახლება"

msgid "Retry saving"
msgstr "შენახვის ხელახლა ცდა"

msgid "Some changes need attention. Check the message beside your set."
msgstr "ზოგ ცვლილებას ყურადღება სჭირდება. ნახეთ შეტყობინება სეტთან."

msgid "All changes saved"
msgstr "ყველა ცვლილება შენახულია"

msgid "Review unsaved set edits"
msgstr "შეუნახავი სეტების გადახედვა"

msgid "Recovered edits are ready to review. Save each set you want to keep."
msgstr "აღდგენილი ცვლილებები მზადაა გადასახედად. შეინახეთ სასურველი სეტები."

msgid "Rest complete. Ready for your next set."
msgstr "დასვენება დასრულდა. მზად ხართ შემდეგი სეტისთვის."

msgid "exercises selected"
msgstr "სავარჯიშო არჩეულია"

msgid "Remove"
msgstr "ამოშლა"

msgid "Some changes need attention. Check the highlighted fields."
msgstr "ზოგიერთ ცვლილებას ყურადღება სჭირდება. შეამოწმეთ მონიშნული ველები."

msgid "Your latest sets will save before the workout finishes."
msgstr "ბოლო სეტები ვარჯიშის დასრულებამდე შეინახება."

msgid "sets complete"
msgstr "სეტი შესრულებულია"

msgid "Unfinished sets will be skipped. Your completed sets are kept."
msgstr "დაუსრულებელი სეტები გამოტოვებული იქნება. შესრულებული სეტები შენარჩუნდება."

msgid "Your workout is ready to save."
msgstr "თქვენი ვარჯიში მზადაა შესანახად."

msgid ""
"Mark at least one set complete using its check button, then finish your "
"workout."
msgstr "მონიშნეთ სულ მცირე ერთი სეტი მისი ნიშნულით და შემდეგ დაასრულეთ ვარჯიში."

msgid "Save or review your recovered set edits before finishing."
msgstr "დასრულებამდე შეამოწმეთ ან შეინახეთ აღდგენილი ცვლილებები."

msgid "Enable sound"
msgstr "ხმის ჩართვა"

msgid "Sound unavailable"
msgstr "ხმა მიუწვდომელია"

msgid "Sound on"
msgstr "ხმა ჩართულია"

msgid "Rest complete"
msgstr "დასვენება დასრულდა"

msgid "Rest timer"
msgstr "დასვენების ტაიმერი"
