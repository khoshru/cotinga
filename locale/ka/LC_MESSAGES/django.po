msgstr "ვარჯიშების ილუსტრაციები"

msgid "Reference variation"
msgstr "ნაჩვენები ვარიანტი"

msgid "MOVEMENT REFERENCE"
msgstr "მოძრაობის მაგალითი"

msgid "Start position"
msgstr "საწყისი პოზიცია"

msgid "Movement position"
msgstr "მოძრაობის პოზიცია"

msgid "Delete routine"
msgstr "პროგრამის წაშლა"

msgid "Routine actions"
msgstr "პროგრამის მართვა"

msgid "Sets, targets, and rest"
msgstr "სეტები, მიზნები და დასვენება"

