msgstr "პროგრამის დატოვება"

msgid "Log sets"
msgstr "სეტების ჩაწერა"

msgid "How to enter weights"
msgstr "როგორ ჩავწეროთ წონები"

msgid "View movement reference"
msgstr "მოძრაობის მაგალითის ნახვა"

msgid "Time"
msgstr "დრო"

msgid "Distance / time"
msgstr "მანძილი / დრო"

msgid "Weight / reps"
msgstr "წონა / გამეორებები"

msgid "Done"
msgstr "მზადაა"

msgid "Set options"
msgstr "სეტის პარამეტრები"

msgid "Remove"
msgstr "ამოშლა"

msgid "Finish workout?"
msgstr "დავასრულოთ ვარჯიში?"

msgid "Keep training"
msgstr "ვარჯიშის გაგრძელება"

msgid "Save and finish"
msgstr "შენახვა და დასრულება"

msgid ""
"The model did not return a usable plan for your days and equipment. Your "
"description is kept; try again or choose another model."
msgstr "მოდელმა თქვენი დღეებისა და აღჭურვილობისთვის გამოსადეგი გეგმა ვერ შექმნა. აღწერა შენახულია; სცადეთ ხელახლა ან აირჩიეთ სხვა მოდელი."

msgid "Tell us what you want"
msgstr "მოგვიყევით, რა გსურთ"

