msgstr "ვარჯიშის გამოცდილება"

msgid "Beginner"
msgstr "დამწყები"

msgid "Intermediate"
msgstr "საშუალო"

msgid "Advanced"
msgstr "გამოცდილი"

msgid "Available equipment"
msgstr "ხელმისაწვდომი აღჭურვილობა"

msgid "Bench or sturdy seat"
msgstr "სკამი ან მყარი დასაჯდომი"

msgid "Pull-up bar"
msgstr "ტურნიკი"

msgid "Dip bars"
msgstr "ორძელი"

msgid "Step or exercise box"
msgstr "საფეხური ან სავარჯიშო ყუთი"

