msgstr "ჩემი დამატებული სავარჯიშოებიც გამოიყენე"

msgid "Save this routine"
msgstr "ამ პროგრამის შენახვა"

msgid "Keep at most 48 sets in one suggested workout."
msgstr "ერთ შეთავაზებულ ვარჯიშში დატოვეთ მაქსიმუმ 48 სეტი."

msgid "A plan was just requested. Wait a moment before generating another."
msgstr "გეგმა ახლახან მოითხოვეთ. ახალი გეგმის შექმნამდე ცოტა მოიცადეთ."

msgid ""
"You have reached today's 20-plan limit. You can still build and edit "
"routines manually."
msgstr "დღევანდელი 20 გეგმის ლიმიტი ამოწურულია. პროგრამების ხელით შექმნა და შეცვლა კვლავ შეგიძლიათ."

msgid "Archive some routines before adding this weekly plan."
msgstr "ამ კვირის გეგმის დამატებამდე რამდენიმე პროგრამა დააარქივეთ."

msgid "Connect OpenRouter and choose a model in AI settings first."
msgstr "ჯერ AI-ის პარამეტრებში დააკავშირეთ OpenRouter და აირჩიეთ მოდელი."

msgid ""
"No exercises match this equipment. Choose different equipment or add a "
"custom exercise."
msgstr "ამ აღჭურვილობისთვის სავარჯიშო ვერ მოიძებნა. აირჩიეთ სხვა აღჭურვილობა ან დაამატეთ საკუთარი სავარჯიშო."

msgid ""
"An exercise in this suggestion is no longer available. Generate a fresh plan "
"with the current library."
msgstr "ამ შეთავაზების ერთ-ერთი სავარჯიშო აღარ არის ხელმისაწვდომი. შექმენით ახალი გეგმა არსებული ბიბლიოთეკით."

msgid "The suggestion changed. Reload it before saving."
msgstr "შეთავაზება შეიცვალა. შენახვამდე გვერდი განაახლეთ."

msgid "Choose at least one routine to save."
msgstr "აირჩიეთ სულ მცირე ერთი პროგრამა შესანახად."

msgid ""
"Your routines are ready. Open any routine to start training or make changes."
msgstr "თქვენი პროგრამები მზადაა. ვარჯიშის დასაწყებად ან შესაცვლელად გახსენით სასურველი პროგრამა."

msgid "Preparing"
msgstr "მზადდება"

msgid "Ready to review"
msgstr "მზადაა გადასახედად"

msgid "Could not prepare"
msgstr "მომზადება ვერ მოხერხდა"

msgid "Saved"
msgstr "შენახულია"

msgid "YOUR WEEK. YOUR WAY."
msgstr "თქვენი კვირა. თქვენი წესით."

msgid "Build your training plan"
msgstr "შექმენით თქვენი სავარჯიშო გეგმა"

msgid ""
"Tell us what fits your life. Get routines built from exercises you can "
"actually do."
msgstr "მოგვიყევით, რა ერგება თქვენს ცხოვრებას. მიიღეთ პროგრამები იმ სავარჯიშოებით, რომელთა შესრულებაც შეგიძლიათ."

msgid "Build manually"
msgstr "ხელით შექმნა"

msgid ""
"Bodyweight exercises are always included. Select everything else you have "
"access to."
msgstr "საკუთარი წონით სავარჯიშოები ყოველთვის განიხილება. მონიშნეთ სხვა ხელმისაწვდომი აღჭურვილობა."

msgid "Full gym"
msgstr "სრული დარბაზი"

msgid "Bodyweight only"
msgstr "მხოლოდ საკუთარი წონა"

