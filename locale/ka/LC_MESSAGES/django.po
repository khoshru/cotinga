msgid ""
"Add exercises from the library, or create your own. Set targets and rest "
"times for each movement."
msgstr ""
"დაამატეთ სავარჯიშოები ბიბლიოთეკიდან ან შექმენით საკუთარი. თითოეულს მიუთითეთ "
"მიზნები და დასვენება."

msgid "Choose exercises"
msgstr "სავარჯიშოების არჩევა"

msgid ""
"Use the same superset letter for movements you want to pair. Set rest to 0 "
"for movements you want to move between without a timer."
msgstr ""
"დაწყვილებულ სავარჯიშოებს სუპერსეტის ერთი ასო მიანიჭეთ. ტაიმერის გარეშე "
"გადასასვლელად დასვენება 0-ზე დააყენეთ."

msgid "Duplicate routine"
msgstr "პროგრამის ასლის შექმნა"

msgid "Restore routine"
msgstr "პროგრამის აღდგენა"

msgid "Archive routine"
msgstr "პროგრამის დაარქივება"

msgid "Ready when you are"
msgstr "როცა მზად იქნებით"

msgid "Start with a blank session. Add movements as you go."
msgstr "დაიწყეთ ცარიელი სესიით. გზადაგზა დაამატეთ სავარჯიშოები."

msgid ""
"Your latest weigh-in on or before this date becomes this session's "
"bodyweight. You can change it inside the workout."
msgstr ""
"ამ თარიღზე ან მანამდე ბოლო აწონვა სესიის სხეულის წონა გახდება. მისი შეცვლა "
"ვარჯიშში შეგიძლიათ."

msgid "Workouts"
msgstr "ვარჯიშები"

msgid "In the selected period"
msgstr "არჩეულ პერიოდში"

msgid "Working sets"
msgstr "სამუშაო სეტები"

msgid "Warm-ups excluded"
msgstr "გასახურებელი სეტების გარეშე"

msgid "Logged volume"
msgstr "ჩაწერილი მოცულობა"

msgid "External weight × reps"
msgstr "გარე წონა × გამეორებები"

msgid "Time training"
msgstr "ვარჯიშის დრო"

msgid "min"
msgstr "წთ"

msgid "Paused time excluded"
msgstr "პაუზის გარეშე"

msgid "One set at a time. Your numbers save as you go."
msgstr "თითო სეტი. შედეგები ვარჯიშისას ინახება."

msgid "Work logged. Take a moment to see what you built."
msgstr "ვარჯიში ჩაწერილია. შეხედეთ, რას მიაღწიეთ."

msgid "All changes saved"
msgstr "ყველა ცვლილება შენახულია"

msgid "Retry saving"
msgstr "შენახვის ხელახლა ცდა"

msgid "sets complete"
msgstr "სეტი დასრულებულია"

msgid "kg logged volume"
msgstr "კგ ჩაწერილი მოცულობა"

msgid "Session bodyweight"
msgstr "სხეულის წონა სესიაში"

msgid "Add session bodyweight"
msgstr "სესიის სხეულის წონის დამატება"

#, python-format
msgid ""
"Bodyweight snapshot from %(day)s. Later weigh-ins will not change this "
"workout."
msgstr ""
"სხეულის წონა აღებულია %(day)s-დან. შემდგომი აწონვები ამ ვარჯიშს არ შეცვლის."

msgid "Workout details and notes"
msgstr "ვარჯიშის დეტალები და შენიშვნები"

msgid "Save workout details"
msgstr "ვარჯიშის დეტალების შენახვა"

msgid ""
"Barbell weight includes the bar. Dumbbell weight is per dumbbell. For "
"bodyweight movements, enter only additional weight; for assisted movements, "
"enter the assistance."
msgstr ""
"შტანგის წონაში ღერძიც შედის. ჰანტელის წონა ჩაწერეთ თითო ჰანტელზე. სხეულის "
"წონით მოძრაობებში ჩაწერეთ მხოლოდ დამატებითი წონა, დახმარებით მოძრაობებში კი "
"დახმარება."

msgid "Set"
msgstr "სეტი"

msgid "Effort / RPE"
msgstr "დატვირთვა / RPE"

msgid "Optional: 10 means no more reps were possible."
msgstr "არასავალდებულო: 10 ნიშნავს, რომ მეტი გამეორება ვეღარ შეგეძლოთ."

msgid "Save set"
msgstr "სეტის შენახვა"

msgid "Remove this set?"
msgstr "ამოვიღოთ ეს სეტი?"

msgid "Remove set"
msgstr "სეტის ამოღება"

msgid "Add set"
msgstr "სეტის დამატება"

msgid "s rest"
msgstr "წმ დასვენება"

msgid "Rest, superset, and exercise notes"
msgstr "დასვენება, სუპერსეტი და შენიშვნები"

